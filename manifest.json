{
  "manifest_version": 3,
  "name": "Rezka · двойные субтитры",
  "version": "0.1.0",
  "description": "Английские и русские субтитры на HDRezka: два языка или перевод реплики по нажатию.",
  "minimum_chrome_version": "111",
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Двойные субтитры Rezka", "default_popup": "popup.html"},
  "content_scripts": [
    {
      "matches": ["*://rezka.ag/*", "*://*.rezka.ag/*", "*://hdrezka.sb/*", "*://*.hdrezka.sb/*", "*://hdrezka.ag/*", "*://*.hdrezka.ag/*", "*://hdrezka.me/*", "*://*.hdrezka.me/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://rezka.ag/*", "*://*.rezka.ag/*", "*://hdrezka.sb/*", "*://*.hdrezka.sb/*", "*://hdrezka.ag/*", "*://*.hdrezka.ag/*", "*://hdrezka.me/*", "*://*.hdrezka.me/*"],
      "js": ["core.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
